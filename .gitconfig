# Identity

[user]
	email = nyanpasu64@tuta.io
	name = nyanpasu64
[core]
	autocrlf = input
	editor = kwrite
	sshCommand = ssh -i ~/.ssh/id_ed25519_sk
	excludesfile = ~/.gitignore_global
[includeIf "gitdir:~/ternary/"]
	path = ~/.gitconfig-ternary

# Config
[advice]
	detachedHead = false
	skippedCherryPicks = false
[log]
	mailmap = true
[mailmap]
	file = ~/.git/mailmap
[init]
	defaultBranch = dev
[submodule]
	recurse = true
[commit]
	verbose = true

[fetch]
	prune = true
[pull]
	ff = only
[rebase]
	autosquash = true
[rerere]
	enabled = true
	autoupdate = true

# Mergetools
[diff]
	tool = kdiff3
	submodule = diff
[merge]
	tool = kdiff3
	ff = false
	conflictstyle = diff3
[mergetool]
	keepBackup = false

[diff "sqlite3"]
	binary = true
	textconv = "echo .dump | sqlite3"

# Aliases
[alias]
	co = checkout
	fa = fetch --all
	b = branch
	rs = restore -WSs
	cp = cherry-pick
	mt = mergetool
	rb = rebase
	pushu = push -u origin HEAD
	move = branchless move

# External tools
[cola]
	spellcheck = false
	fontdiff = IBM Plex Mono,9,-1,5,50,0,0,0,0,0
	startupmode = folder
	tabwidth = 4
	boldheaders = false
	blockcursor = false
	hidpi = 0
[gui]
	editor = kwrite
	historybrowser = git dag --all
[absorb]
	maxStack = 100

# ???
[url "https://invent.kde.org/"]
	insteadOf = kde:
[url "ssh://git@invent.kde.org/"]
	pushInsteadOf = kde:
[safe]
	directory = /boot/loader
	directory = /mnt/shared/opencore/OpenCore-0.8.2-DEBUG
	directory = /mnt/storage/vm
	directory = /mnt/shared/ROMS/SNES-GAMES
	directory = /mnt/shared/Shared Documents/zola-site
	directory = /mnt/storage
	directory = /mnt/storage/backup-web/drive-download-20230710T042318Z
	directory = /run/media/nyanpasu64/737d32af-0bc6-4eca-998e-399ef8978cb5/@/tmp/drive-rewrite
	directory = /run/media/nyanpasu64/linuxrootfs/.config/retroarch
[push]
	autoSetupRemote = true
	default = upstream
[diff "hex"]
	textconv = hexdump -v -C
	binary = true
[diff "edid-decode"]
	textconv = edid-decode
	binary = true
[diff "furnace"]
	textconv = furnace-diff
	binary = true

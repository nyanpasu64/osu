[user]
	email = nyanpasu64@tuta.io
	name = nyanpasu64
[core]
	autocrlf = input
	editor = kwrite
	sshCommand = ssh -i ~/.ssh/id_ed25519
	excludesfile = ~/.gitignore_global

[includeIf "gitdir:~/ternary/"]
	path = ~/.gitconfig-ternary

[merge]
	tool = kdiff3
	ff = false
[rebase]
	autosquash = true
[rerere]
	enabled = true
	autoupdate = true
[cola]
	spellcheck = false
	fontdiff = IBM Plex Mono,9,-1,5,50,0,0,0,0,0
	startupmode = folder
	tabwidth = 4
	boldheaders = false
[pull]
	ff = only
[advice]
	detachedHead = false
	skippedCherryPicks = false
[alias]
	co = checkout
	fa = fetch --all
	b = branch
	rs = restore -WSs
	cp = cherry-pick
	mt = mergetool
	rb = rebase
	pushu = push -u origin HEAD
	move = branchless move
[gui]
	editor = kwrite
	historybrowser = git dag --all
[mergetool]
	keepBackup = false
[diff]
	tool = kdiff3
[mailmap]
	file = ~/.git/mailmap
[absorb]
	maxStack = 100
[log]
	mailmap = true
[init]
	defaultBranch = master
[url "https://invent.kde.org/"]
	insteadOf = kde:
[url "ssh://git@invent.kde.org/"]
	pushInsteadOf = kde:
[fetch]
	prune = true
[sequence]
	editor = /home/nyanpasu64/.restack/edit.sh
[submodule]
	recurse = true

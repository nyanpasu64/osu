HDMI=DVI-1
if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
	HDMI=DVI-D-1
fi

kscreen-doctor \
output.DP-1.enable \
output.$HDMI.enable \
output.DP-2.disable \

kscreen-doctor \
output.DP-1.mode.2560x1440@60 \
output.$HDMI.mode.1920x1080@60 \

kscreen-doctor \
output.DP-1.position.0,0 \
output.DP-1.primary \
output.$HDMI.position.-1080,0 \
output.$HDMI.rotation.left

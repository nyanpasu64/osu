#!/bin/bash

# HDMI=HDMI-1
# if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
# 	HDMI=HDMI-A-1
# fi
HDMI=DVI-D-1

kscreen-doctor \
output.DP-1.enable \
output.$HDMI.enable;

# may not always be present
kscreen-doctor \
output.DP-2.disable;

kscreen-doctor \
output.DP-1.mode.2560x1440@60 \
output.$HDMI.mode.1920x1080@60;
if [[ "$XDG_SESSION_TYPE" == "x11" ]]; then
	xrandr --output $HDMI --mode "1920x1080" || true
fi

kscreen-doctor \
output.DP-1.position.0,0 \
output.DP-1.primary \
output.$HDMI.position.2560,0 \
output.$HDMI.rotation.left;

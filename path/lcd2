#!/bin/bash

HDMI=HDMI-3
DIV=1
if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
	HDMI=HDMI-A-3
	DIV=1.25
fi

kscreen-doctor \
output.DP-1.enable \
output.$HDMI.enable;

# may not always be present
kscreen-doctor \
output.DP-2.disable;

kscreen-doctor \
output.DP-1.mode.2560x1440@75 \
output.$HDMI.mode.1920x1080@60;
if [[ "$XDG_SESSION_TYPE" == "x11" ]]; then
	xrandr --output $HDMI --mode "1920x1080" || true
fi

kscreen-doctor \
output.DP-1.position.0,$(echo 112/$DIV|bc) \
output.DP-1.primary \
output.$HDMI.position.$(echo 2560/$DIV|bc),0 \
output.$HDMI.rotation.left;

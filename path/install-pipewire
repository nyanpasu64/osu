#!/usr/bin/fish
sudo pacman -R \
	pulseaudio-equalizer \
	pulseaudio-jack \
	pulseaudio-rtp \
	pulseaudio-zeroconf \
	pulseaudio-alsa
	# pulseaudio-bluetooth

yes | paru -S --needed pipewire-git pipewire-alsa-git pipewire-pulse-git wireplumber-git --assume-installed hotdoc

systemctl --user disable --now pulseaudio pulseaudio.socket
systemctl --user enable --now pipewire pipewire.socket
systemctl --user enable --now pipewire-pulse pipewire-pulse.socket wireplumber
